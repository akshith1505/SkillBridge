# SkillBridge Production Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://skillbridge.example.edu

# Production Database Credentials
DATABASE_URL=postgresql://skillbridge_prod_user:ReplaceWithStrongSecretPass@db.internal:5432/skillbridge_prod_db
POSTGRES_USER=skillbridge_prod_user
POSTGRES_PASSWORD=ReplaceWithStrongSecretPass
POSTGRES_DB=skillbridge_prod_db

# Production Authentication (Must be randomized 64-char key)
JWT_SECRET=ReplaceWithGenerated64CharCryptographicSecretKeyInProduction
JWT_EXPIRES_IN=7d

# Production SMTP Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=ReplaceWithSendGridApiKey
SMTP_FROM="SkillBridge Platform <noreply@skillbridge.edu>"

# AI Provider Configuration
AI_PROVIDER=none
AI_API_KEY=
AI_TIMEOUT_MS=5000
