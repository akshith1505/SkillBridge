# ==============================================================================
# SKILLBRIDGE ROOT ENVIRONMENT CONFIGURATION (SUPABASE CLOUD)
# ==============================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS Allowed Client Origins
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============================================================
# DATABASE — Supabase PostgreSQL (Cloud)
# Replace with your actual Supabase project credentials
# Project Settings → Database → Connection string → URI mode
# Database Configuration (PostgreSQL with automatic In-Memory Fallback)
# Use your Supabase connection string from:
# Supabase Dashboard → Settings → Database → Connection string → URI
# ============================================================
DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10

# ============================================================
# Supabase Cloud — Project Credentials
# Supabase Dashboard → Settings → API
# ============================================================
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# Security & Authentication (JWT)
JWT_SECRET=skillbridge_sih26134_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Email Service (console | smtp)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SkillBridge Notifications <notifications@skillbridge.edu>"

# ============================================================
# AI Intelligence Service — Groq Cloud (Ultra-Fast LLM)
# Get your free API key at: https://console.groq.com/keys
# Supported models:
#   llama-3.3-70b-versatile  (best quality, recommended)
#   llama-3.1-8b-instant     (fastest, lowest latency)
#   mixtral-8x7b-32768       (long context)
#   gemma2-9b-it             (lightweight)
# ============================================================
AI_PROVIDER=groq
AI_API_KEY=gsk_YourGroqApiKeyHere
